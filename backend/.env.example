# Supabase Project Configuration
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Necessário apenas para scripts que usam a Management API / MCP do Supabase.
SUPABASE_ACCESS_TOKEN=

# Portal individual do técnico. Use um segredo longo e exclusivo em produção.
TECHNICIAN_PORTAL_SECRET=
TECHNICIAN_PORTAL_LINK_TTL_HOURS=72

# URL pública usada pelo dashboard do técnico. Em produção, use HTTPS.
# Em desenvolvimento, se ficar vazia, o backend detecta o IP da rede local.
PUBLIC_APP_URL=

# Google Agenda: sincronização automática a cada 10 minutos.
# Na primeira execução, o backend também procura e migra o credentials.json/token.pickle
# da instalação legada em Documents\Agenda Online.
GOOGLE_CALENDAR_SYNC_ENABLED=true
GOOGLE_CALENDAR_SYNC_CRON=*/10 * * * *
# GOOGLE_CALENDAR_CREDENTIALS_PATH=C:\caminho\seguro\credentials.json
# GOOGLE_CALENDAR_TOKEN_PATH=C:\caminho\seguro\google-calendar-token.json
# GOOGLE_CALENDAR_IDS=calendario1@group.calendar.google.com,calendario2@group.calendar.google.com
# PYTHON_EXECUTABLE=C:\Python314\python.exe
