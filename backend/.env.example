# ==============================================================================
# ATEM FIELD - CONFIGURAÇÃO DE SEGURANÇA E AMBIENTE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR & AMBIENTE
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
PUBLIC_APP_URL=https://seu-dominio-ou-url-publica
CORS_ALLOWED_ORIGINS=https://seu-frontend-ou-dominio

# ------------------------------------------------------------------------------
# 2. CRIPTOGRAFIA SIMÉTRICA (AES-256-GCM)
# Chave mestra de 256 bits (32 bytes em Hexadecimal).
# Gere uma chave segura no terminal executando:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
ENCRYPTION_MASTER_KEY=gere-64-caracteres-hexadecimais-e-guarde-como-segredo

# ------------------------------------------------------------------------------
# 3. AUTENTICAÇÃO JWT (JSON Web Tokens)
# Chave secreta de alta entropia para assinatura dos tokens HMAC-SHA256.
# Gere uma chave segura no terminal executando:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------------------------
JWT_SECRET=gere-uma-chave-aleatoria-de-alta-entropia-e-guarde-como-segredo
JWT_EXPIRES_IN=12h

# ------------------------------------------------------------------------------
# 3b. ASSISTENTE ATEM (opcionais no MVP; nunca exponha no frontend)
# ------------------------------------------------------------------------------
SUPPORT_LLM_API_URL=
SUPPORT_LLM_API_KEY=
SUPPORT_LLM_MODEL=small-fast
SUPPORT_LLM_REASONING_EFFORT=minimal
SUPPORT_TTS_MODEL=gemini-3.1-flash-tts-preview
SUPPORT_TTS_VOICE=Kore
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=

# ------------------------------------------------------------------------------
# 4. POLÍTICA DE HASHING DE SENHAS & PINS (Bcrypt)
# Quantidade de Salt Rounds para Bcrypt (Recomendação OWASP: 12).
# ------------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 5. CREDENCIAIS DE BANCO DE DADOS & SERVIÇOS EM NUVEM (Supabase)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
SUPABASE_ANON_KEY=sua-anon-key-aqui

# ------------------------------------------------------------------------------
# 6. GOOGLE CALENDAR
# ------------------------------------------------------------------------------
GOOGLE_CALENDAR_SYNC_ENABLED=true
GOOGLE_CALENDAR_SYNC_CRON=*/10 * * * *
GOOGLE_CALENDAR_IDS=
# A integração apenas lê agendas e eventos; não solicite permissão de escrita.
GOOGLE_CALENDAR_CREDENTIALS_JSON={"installed":{"client_id":"..."}}
GOOGLE_CALENDAR_TOKEN_JSON={"token":"...","refresh_token":"..."}
PYTHON_EXECUTABLE=python3

# ------------------------------------------------------------------------------
# 7. PORTAL DOS TÉCNICOS
# ------------------------------------------------------------------------------
TECHNICIAN_PORTAL_SECRET=gere-uma-chave-aleatoria-forte
TECHNICIAN_PORTAL_LINK_TTL_HOURS=72

# ------------------------------------------------------------------------------
# 8. ORDENS DE SERVICO (integradas ao ATEM Field)
# ------------------------------------------------------------------------------
OS_SUPABASE_URL=https://seu-projeto-os.supabase.co
OS_SUPABASE_ANON_KEY=sua-publishable-key-do-projeto-os

# Os PDFs mantêm o formulário PAT01-F2 original e são arquivados nas mesmas
# pastas do Google Drive usadas pelo ATEM OS. Use o token OAuth autorizado do
# proprietário dessas pastas: codifique o token.json inteiro em Base64 e
# cadastre o valor como segredo na hospedagem. Conta de serviço sem Shared
# Drive não possui cota própria e não consegue gravar em um Drive pessoal.
GOOGLE_DRIVE_OAUTH_TOKEN_JSON_BASE64=base64-do-token-json-oauth
GOOGLE_DRIVE_OS_UNSIGNED_FOLDER_ID=1IWdsd9B2ZGRotVdzt6OVzu6NjM7SnRdS
GOOGLE_DRIVE_OS_SIGNED_FOLDER_ID=13OOs4zsvGJh9RGKJ1sK_hMugTmL-kmKi

# No Docker esta variável já aponta para /usr/bin/chromium. Defina apenas se
# o executável estiver em outro caminho no ambiente de publicação.
CHROMIUM_EXECUTABLE=/usr/bin/chromium
