# ==============================================================================
# ATEM FIELD - CONFIGURAÇÃO DE SEGURANÇA E AMBIENTE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR & AMBIENTE
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
PUBLIC_APP_URL=https://seu-dominio-ou-url-publica

# ------------------------------------------------------------------------------
# 2. CRIPTOGRAFIA SIMÉTRICA (AES-256-GCM)
# Chave mestra de 256 bits (32 bytes em Hexadecimal).
# Gere uma chave segura no terminal executando:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
ENCRYPTION_MASTER_KEY=4a8f9c2d1b7e5a3f6c8d0e2b4a6c8e0f1a3b5c7d9e1f3a5b7c9d1e3f5a7b9c1d

# ------------------------------------------------------------------------------
# 3. AUTENTICAÇÃO JWT (JSON Web Tokens)
# Chave secreta de alta entropia para assinatura dos tokens HMAC-SHA256.
# Gere uma chave segura no terminal executando:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------------------------
JWT_SECRET=e7b8c9d0a1f2e3d4c5b6a7f8e9d0c1b2a3f4e5d6c7b8a9f0e1d2c3b4a5f6e7d8c9b0a1f2
JWT_EXPIRES_IN=12h

# ------------------------------------------------------------------------------
# 4. POLÍTICA DE HASHING DE SENHAS & PINS (Bcrypt)
# Quantidade de Salt Rounds para Bcrypt (Recomendação OWASP: 12).
# ------------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 5. CREDENCIAIS DE BANCO DE DADOS & SERVIÇOS EM NUVEM (Supabase)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
SUPABASE_ANON_KEY=sua-anon-key-aqui

# ------------------------------------------------------------------------------
# 6. GOOGLE CALENDAR
# ------------------------------------------------------------------------------
GOOGLE_CALENDAR_SYNC_ENABLED=true
GOOGLE_CALENDAR_SYNC_CRON=*/10 * * * *
GOOGLE_CALENDAR_IDS=
# A integração apenas lê agendas e eventos; não solicite permissão de escrita.
GOOGLE_CALENDAR_CREDENTIALS_JSON={"installed":{"client_id":"..."}}
GOOGLE_CALENDAR_TOKEN_JSON={"token":"...","refresh_token":"..."}
PYTHON_EXECUTABLE=python3

# ------------------------------------------------------------------------------
# 7. PORTAL DOS TÉCNICOS
# ------------------------------------------------------------------------------
TECHNICIAN_PORTAL_SECRET=gere-uma-chave-aleatoria-forte
TECHNICIAN_PORTAL_LINK_TTL_HOURS=72
