{
  "name": "quick-turing-backend",
  "version": "1.0.0",
  "description": "Backend service for Technician Workflow & Analyzer Reservation Platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test:e2e": "node tests/e2e_runner.js",
    "test:fleet": "node tests/fleet_management.test.js",
    "test:service-orders": "npm run build && node --test tests/service_orders_fallback.test.js",
    "test:calendar": "npm run build && node --test tests/calendar*.test.js",
    "db:migrate:workflow": "node scripts/apply_migration.js 002_workflow_fleet.sql",
    "sync:checklists": "node scripts/sync-preventive-checklists.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.21.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3",
    "pg": "^8.23.0",
    "typescript": "^5.7.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "ts-node-dev": "^2.0.0"
  }
}
